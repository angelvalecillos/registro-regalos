rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /listas/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /regalos/{regaloId} {
        allow read: if true;

        // El cumpleañero administra sus regalos
        allow create, delete: if request.auth != null && request.auth.uid == uid;

        allow update: if request.auth != null && (
          request.auth.uid == uid ||
          // Un invitado solo puede cambiar quién compró, y solo si está libre o es suyo
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compradoPor', 'compradoUid'])
            && (resource.data.compradoUid == '' || resource.data.compradoUid == request.auth.uid)
            && (request.resource.data.compradoUid == '' || request.resource.data.compradoUid == request.auth.uid))
        );
      }
    }
  }
}
